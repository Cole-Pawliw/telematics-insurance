# Copy this file to .env and replace every "change-me" value.
# Passwords must not contain quotes (') or dollar signs ($).

# --- Postgres: one database, one schema and login per service ---
POSTGRES_DB=telematics_insurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POLICY_DB_PASSWORD=change-me
TELEMATICS_DB_PASSWORD=change-me
BILLING_DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USER=telematics
RABBITMQ_PASSWORD=change-me

# --- Host ports ---
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POLICY_SERVICE_PORT=5001
TELEMATICS_SERVICE_PORT=5002
BILLING_SERVICE_PORT=5003
WEB_PORT=3000
